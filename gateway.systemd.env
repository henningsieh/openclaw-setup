# Managed by OpenClaw setup (startup optimization, 2026-09-21).
# Loaded by openclaw-gateway.service via EnvironmentFile=-/home/shelldon/.openclaw/gateway.systemd.env
# NOTE: suggested /var/tmp/openclaw-compile-cache is root-owned and not
# writable by service user `shelldon`, so we use a shelldon-owned XDG cache dir.
NODE_COMPILE_CACHE=/home/shelldon/.cache/openclaw-compile-cache
OPENCLAW_NO_RESPAWN=1
