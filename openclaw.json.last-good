{
  "agents": {
    "defaults": {
      "authInheritance": {
        "agentId": "shelldon"
      },
      "workspace": "/home/shelldon/.openclaw/workspace",
      "model": {
        "primary": "opencode-go/deepseek-v4.1-flash",
        "fallbacks": [
          "nvidia/nemotron-3-super-120b-a12b"
        ]
      },
      "modelPolicy": {
        "allow": [
          "opencode-go/deepseek-v4.1-flash",
          "opencode-go/glm-5.3-flash",
          "opencode-go/mimo-v2.6-flash",
          "opencode-go/minimax-m3.1-flash-free",
          "opencode-go/qwen3.8-flash",
          "opencode-go/muse-spark-1.2-contributor",
          "opencode-go/muse-spark-1.3-contributor",
          "google/*",
          "llama-cpp/*",
          "nvidia/*",
          "openai/*"
        ]
      },
      "thinkingDefault": "high",
      "heartbeat": {
        "every": "0m"
      },
      "systemAgent": {
        "agentId": "shelldon"
      }
    },
    "ownership": "explicit",
    "entries": {
      "shelldon": {
        "name": "Shelldon",
        "workspace": "/home/shelldon/.openclaw/workspace",
        "agentDir": "/home/shelldon/.openclaw/agents/shelldon/agent",
        "identity": {
          "name": "Shelldon",
          "avatar": "avatars/shelldon.png"
        },
        "tools": {
          "alsoAllow": [
            "vault_fetch"
          ]
        },
        "heartbeat": {
          "every": "30m",
          "target": "discord",
          "to": "1489587973715656786",
          "isolatedSession": true,
          "activeHours": {
            "start": "06:20",
            "end": "06:45",
            "timezone": "Europe/Berlin"
          },
          "prompt": "[Morning Heartbeat] Daily morning digest. Step 1 health: run ONE exec with this exact command: df -h / | tail -1; free -m | head -2; openclaw cron list --all | grep -c error; node /home/shelldon/.openclaw/workspace/lanz_cron/lanz-health.js. Step 2 backlog: read /home/shelldon/.openclaw/workspace/backlog_todos.md and pick exactly ONE open item that is the best next step. Step 3 reply in German with EXACTLY three lines and nothing else: line 1 Morgen, Human! ; line 2 Status: plus one sentence; line 3 Vorschlag: plus that ONE backlog item and a few-word reason. The Lanz line is silent on non-show days; if it reports a problem (FEHLT, 0 Gaeste, or Pruefung fehlgeschlagen), append it to line 2 in a few words, otherwise do not mention it. Never create or modify automation jobs. Do not reply NO_REPLY unless the health check itself completely failed.",
          "timeoutSeconds": 360,
          "model": "opencode-go/muse-spark-1.3-contributor"
        }
      },
      "kalle-kief": {
        "name": "Kalle Kief",
        "workspace": "/home/shelldon/.openclaw/workspace-kalle-kief",
        "agentDir": "/home/shelldon/.openclaw/agents/kalle-kief/agent",
        "identity": {
          "name": "Kalle Kief",
          "avatar": "avatars/Kalle-Kief.png",
          "emoji": "👨‍🌾🌱🧮",
          "theme": "Entspannter Hanf-Grower mit Taschenrechner, Lupe und trockenem Humor"
        },
        "skills": [
