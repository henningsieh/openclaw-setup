# 0. Base image — defaults to official ghcr.io release, but can be overridden
#    with OPENCLAW_BASE_IMAGE to use a locally built image (e.g. with a PR merged in).
ARG OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw
ARG OPENCLAW_VERSION=latest
FROM ${OPENCLAW_BASE_IMAGE}:${OPENCLAW_VERSION}
ARG OPENCLAW_VERSION

LABEL org.opencontainers.image.title="openclaw-gateway" \
      org.opencontainers.image.version="${OPENCLAW_VERSION}"

ARG GO_VERSION
ARG QCARD_VERSION
ARG CLAWHUB_CLI_VERSION
ARG BROWSER_USE_CLI_VERSION

# Guard at build time — fail fast rather than produce a silent no-op
RUN test -n "${GO_VERSION}"                              || (echo "GO_VERSION is required" && exit 1)
RUN test -n "${QCARD_VERSION}"                           || (echo "QCARD_VERSION is required" && exit 1)
RUN test -n "${CLAWHUB_CLI_VERSION}"                     || (echo "CLAWHUB_CLI_VERSION is required" && exit 1)
RUN test -n "${BROWSER_USE_CLI_VERSION}"                  || (echo "BROWSER_USE_CLI_VERSION is required" && exit 1)

# 1. System deps (root required)
USER root
# Pass 1: install base packages from the distro repos (fully signed, no workarounds needed).
#          curl and gnupg must be present before we can import third-party signing keys.
# Pass 2: add signing keys + source entries for gh CLI and Google Chrome,
#          then install both in a single apt-get update + install pass.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    # --- Core utilities ---
    jq ripgrep ca-certificates curl gnupg git \
    # --- IT Admin / Networking ---
    iputils-ping iproute2 net-tools dnsutils traceroute mtr telnet \
    netcat-openbsd tcpdump nmap whois \
    # --- System monitoring ---
    procps htop dstat glances sysstat strace \
    # --- File processing ---
    file tree less vim-tiny unzip zip p7zip-full \
    # --- Storage / Hardware ---
    fdisk util-linux parted smartmontools \
    # --- Other ---
    rsync openssh-client wget bc \
    # --- Network testing & monitoring ---
    iperf3 socat hping3 arp-scan iftop nethogs \
    # --- System inspection ---
    lsof ncdu lshw dmidecode hdparm xxd \
    # --- Directory / identity ---
    ldap-utils smbclient krb5-user \
    # --- SNMP ---
    snmp \
    # --- TLS / PKI ---
    openssl gnutls-bin \
    # --- Scripting ---
    python3 python-is-python3 python3-pip nano \
    # --- Virtual display for headed browser mode (Cloudflare bypass) ---
    xvfb xauth \
    # --- CalDAV calendar support ---
    vdirsyncer khal \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
 && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /usr/share/keyrings/google-linux-signing-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/google-linux-signing-keyring.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    gh \
    google-chrome-stable \
    fonts-liberation libnss3 libatk-bridge2.0-0 libxss1 \
    libgtk-3-0 libgbm1 libasound2 \
 && rm -rf /var/lib/apt/lists/* \
 && update-ca-certificates

# Set timezone to Europe/Berlin (for tools reading /etc/localtime directly)
RUN ln -sf /usr/share/zoneinfo/Europe/Berlin /etc/localtime && dpkg-reconfigure -f noninteractive tzdata

# 2. Python tools (root required — externally managed environment)
RUN pip3 install uptime-kuma-api --no-cache-dir --break-system-packages
# Hoymiles cloud monitor Python environment
RUN python3 -m venv /opt/hoymiles-cloud/venv \
    && /opt/hoymiles-cloud/venv/bin/pip install --no-cache-dir \
        aiohttp=${AIOHTTP_VERSION} argon2-cffi=${ARGON2_VERSION}
# 3. Go (root required to place in /usr/local)
RUN rm -rf /usr/local/go \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-$(dpkg --print-architecture).tar.gz" -o /tmp/go.tgz \
 && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm -f /tmp/go.tgz

# 3. Install hcloud CLI (Hetzner Cloud CLI) — used for managing Hetzner server instances
# Binary is at the tarball root, so tar -xz extracts it directly.
RUN curl -fsSL "https://github.com/hetznercloud/cli/releases/latest/download/hcloud-linux-amd64.tar.gz" \
  | tar -xz \
  && mv hcloud /usr/local/bin/hcloud \
  && chmod +x /usr/local/bin/hcloud

# 4. Entrypoint + Vaultwarden resolver (root required)
# The legacy vault-fetch shell bridge has been removed; agent credential
# access is now the native vault_fetch tool plugin (built in step 8).
COPY scripts/openclaw-init.sh /usr/local/bin/openclaw-entrypoint.sh
COPY scripts/vaultwarden/openclaw-bw-resolver.mjs /usr/local/bin/openclaw-bw-resolver
RUN chmod +x /usr/local/bin/openclaw-entrypoint.sh \
             /usr/local/bin/openclaw-bw-resolver

# 4. Switch to non-root user for everything else
USER node

# This overrides any missing system defaults in the base image
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# 5. Go env, GOPATH
ENV GOPATH=/home/node/go
ENV PATH=/usr/local/go/bin:/home/node/go/bin:${PATH}
RUN mkdir -p /home/node/go

# 6. Install qcard (user-level Go install)
# qcard is a CLI address book application for CardDAV servers.
# It allows searching, viewing, and managing contacts from CardDAV servers.
# Installed as a standalone binary at /home/node/go/bin/qcard
# Reference: https://pkg.go.dev/ser1.net/qcard
RUN go install ser1.net/qcard@${QCARD_VERSION}

# 7. Install Node.js tools (user-local prefix, no root)
# Set npm to install packages in user directory (no root needed)
RUN echo "prefix=/home/node/.local" >> /home/node/.npmrc

# Create the directory and install tools, including browser-use CLI for browser automation
RUN mkdir -p /home/node/.local \
 && npm install -g @xdevplatform/xurl clawhub@${CLAWHUB_CLI_VERSION} @steipete/summarize @tobilu/qmd @bitwarden/cli browser-use@${BROWSER_USE_CLI_VERSION} \
 && npm cache clean --force

# Patch bw CLI's device identification so Vaultwarden's "New Device Logged
# In" email shows a meaningful name instead of the generic "Linux" derived
# from process.platform. bw has NO supported flag/env/config for this —
# CliPlatformUtilsService.getDeviceString() is hardcoded, and DeviceRequest
# (libs/common/src/auth/models/request/identity-token/device.request.ts)
# reads it directly with no override point. This patches the compiled
# method in place. Verified against @bitwarden/cli@2026.6.0's build/bw.js
# by pulling the actual npm package and reading the source — not guessing.
#
# Fail-closed: if the exact block isn't found (bw version bump reformatted
# it), the node script throws and the build breaks instead of silently
# leaving "Linux" in place.
RUN export BW_JS=/home/node/.local/lib/node_modules/@bitwarden/cli/build/bw.js \
 && node -e ' \
    const fs = require("fs"); \
    const p = process.env.BW_JS; \
    let s = fs.readFileSync(p, "utf8"); \
    const before = `getDeviceString() {\n        const device = DeviceType[this.getDevice()].toLowerCase();\n        return device.replace("cli", "");\n    }`; \
    const after  = `getDeviceString() {\n        return "openclaw-gateway";\n    }`; \
    if (!s.includes(before)) { throw new Error("bw.js getDeviceString() block not found - bw CLI version changed, re-check the patch"); } \
    fs.writeFileSync(p, s.replace(before, after)); \
    console.log("Patched bw CLI device string in " + p); \
  '

# Move bw CLI to a private path so it is NOT on the agent's exec PATH.
# The openclaw-bw-resolver calls it via an explicit compiled-in path;
# removing it from PATH prevents accidental or deliberate credential
# exfiltration via exec("bw unlock ...") from within agent sessions.
RUN mv /home/node/.local/bin/bw /home/node/.local/lib/bw-private \
 && chmod 700 /home/node/.local/lib/bw-private

# Patch the OpenClaw host-env-security policy to strip BW_* Bitwarden
# credentials from the exec tool environment. Without this patch,
# BW_PASSWORD / BW_CLIENTSECRET are inherited by every shell command the
# agent runs, making exec("node /path/to/bw-private ...") a viable
# credential-exfiltration path even after bw is removed from PATH.
#
# Implementation: inject BW_PASSWORD, BW_CLIENTID, BW_CLIENTSECRET into
# blockedOverrideOnlyKeys (stripped from inherited exec env) and add the
# BW_ prefix to blockedOverridePrefixes (blocks injection attempts too).
# BW_SERVER_URL is intentionally left unblocked — it is not a credential.
#
# This is a targeted sed patch against the bundled dist file. The file
# name contains a content-hash and MUST exist for the build to succeed.
# If the hash/name changes on a base-image upgrade, the grep assertions
# below will fail the build (fail-closed) instead of silently skipping.
# To update: run 'grep -r host-env-security-policy /app/dist/' to locate
# the new file, then adjust the sed patterns if the surrounding context
# (e.g. "GITHUB_TOKEN") has also moved.
RUN HOST_ENV_SEC=$(find /app/dist -name 'host-env-security-*.js' | head -1) \
 && [ -f "$HOST_ENV_SEC" ] \
 && sed -i 's/"GITHUB_TOKEN",/"GITHUB_TOKEN",\n\t\t"BW_PASSWORD",\n\t\t"BW_CLIENTID",\n\t\t"BW_CLIENTSECRET",/' "$HOST_ENV_SEC" \
 && sed -i 's/"GIT_CONFIG_",/"GIT_CONFIG_",\n\t\t"BW_",/' "$HOST_ENV_SEC" \
 && grep -q '"BW_PASSWORD"' "$HOST_ENV_SEC" \
 && grep -q '"BW_",' "$HOST_ENV_SEC" \
 && echo "BW_* credentials patched into exec env security policy: $HOST_ENV_SEC"
# Fail-closed guards: if the file is missing or the grep assertions above
# fail, the RUN command exits 1 and stops the build. Turn silent skips
# into build breakage so the patch cannot silently disappear.

# 8. Build the vault-fetch tool plugin
# The plugin runs in-process inside the gateway, so it reads BW_* from the
# gateway environment directly (no /proc/1/environ and no reliance on the
# exec env-stripping patch). Build sequence:
#   1. npm install (dev) — fetches typebox + openclaw (with .d.ts types) + tsc
#      NODE_ENV=development is required: the runtime image sets production,
#      which would skip devDependencies (typescript + @types/node).
#   2. tsc — compiles src/ to dist/ using the npm openclaw .d.ts types.
#      (Runtime image /app has NO .d.ts — types are stripped for size.)
#   3. plugins build — generates openclaw.plugin.json manifest.
#   4. plugins validate — confirms the plugin is well-formed.
#   5. npm prune --production — keeps only the runtime dep (typebox);
#      removes typescript, @types/node, and the npm openclaw copy.
#   6. Symlink node_modules/openclaw -> /app so the built dist/index.js can
#      resolve 'openclaw/plugin-sdk/tool-plugin' at runtime from the bundled
#      gateway package (deduplication — no second openclaw copy shipped).
COPY --chown=node:node plugins/vault-fetch /home/node/.openclaw-plugin-vault-fetch
WORKDIR /home/node/.openclaw-plugin-vault-fetch
RUN NODE_ENV=development npm install --ignore-scripts --no-audit --no-fund --no-package-lock \
 && node_modules/.bin/tsc -p tsconfig.json \
 && node /app/dist/index.js plugins build --entry ./dist/index.js \
 && node /app/dist/index.js plugins validate --entry ./dist/index.js \
 && npm prune --production \
 && ln -sfn /app node_modules/openclaw \
 && rm -rf node_modules/.cache
WORKDIR /app

# Add installed binaries to PATH (bw is no longer in this directory)
ENV PATH=/home/node/.local/bin:$PATH

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:18789/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/openclaw-entrypoint.sh"]
CMD ["node", "dist/index.js", "gateway", "--allow-unconfigured"]
