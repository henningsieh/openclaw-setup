# =====================================================================
# Shelldon's OpenClaw setup — generated/private files kept out of Git.
#
# This repository stores portable setup, identity, documentation, and
# deliberately maintained skill source. It excludes credentials, runtime
# state, downloaded packages/models, and generated memory/session output.
# =====================================================================

# --- Agent runtime and private state ----------------------------------
*.sqlite*
*.sqlite-shm
*.sqlite-wal
/agents/*/agent/codex-home/
/agents/*/qmd/
/agents/*/sessions/

# --- Browser and gateway runtime data ---------------------------------
/browser/
/cache/
/credentials/
/locks/
/logs/
/media/
/migration/
/state/
/tmp/
/tui/
/wiki/

# --- Live gateway configuration ---------------------------------------
# openclaw.json contains the literal gateway token. Keep only the redacted
# openclaw.json.example template under version control.
/openclaw.json
/openclaw.json.last-good
/openclaw.json.bak*

# --- Installed packages and managed local provider assets --------------
# These are downloaded or regenerated by OpenClaw's setup flows.
node_modules/
/npm/
/*/llama[.-]cpp/

# --- Managed plugin skill links ---------------------------------------
# plugin-skills/* contains absolute links into installed OpenClaw plugins.
# Track maintained Workshop skill source instead; never commit these links.
/plugin-skills/

# --- Maintained skill source ------------------------------------------
# agents/*/agent/workshop-skills/** is intentionally NOT ignored. Those
# skill files are portable source and may be reviewed and committed.

# --- Generated memory and Dreaming output ------------------------------
# Private session excerpts, retrieval events, and generated reports/diaries.
# Durable facts belong in workspace/MEMORY.md.
/workspace/DREAMS.md
/workspace/memory/

# --- Secrets and key material ------------------------------------------
/config-journal-fingerprint.key
