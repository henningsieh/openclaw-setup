# =====================================================================
# Shelldon's OpenClaw setup — generated/private files kept out of Git.
#
# This repository stores portable setup, identity, documentation, and
# deliberately maintained skill source. It excludes credentials, runtime
# state, downloaded packages/models, and generated memory/session output.
# =====================================================================

# --- Agent runtime and private state ----------------------------------
*.sqlite*
*.sqlite-shm
*.sqlite-wal
/agents/*/agent/bin/
/agents/*/agent/codex-home/
/agents/*/qmd/
/agents/*/sessions/

# --- Browser and gateway runtime data ---------------------------------
/browser/
/cache/
/credentials/
/locks/
/logs/
/update-reports/
/.maintenance
/.maintainance
/media/
/migration/
/state/
/tmp/
/tui/
/wiki/

# --- Live gateway configuration ---------------------------------------
# `openclaw.json`, `openclaw.json.last-good`, and `openclaw.json.pre-update` are
# tracked on purpose: their credential fields are env references and the values
# stay in the ignored `.env`. Only automatic backups are ignored here; they may
# retain pre-migration plaintext credentials.
/openclaw.json.bak*

# --- Local editor configuration ----------------------------------------
/.vscode/

# --- Installed packages and managed local provider assets --------------
# These are downloaded or regenerated by OpenClaw's setup flows.
node_modules/
/npm/
.husky/_/

# --- Python bytecode caches --------------------------------------------
# Regenerated by any Python run; never portable source.
__pycache__/
*.pyc
*.pyo

# Gateway-managed plugin installations; canonical plugin source lives in /plugins.
/extensions/
/models/
/tools/

# --- Managed plugin skill links ---------------------------------------
# plugin-skills/* contains absolute links into installed OpenClaw plugins.
# Track maintained Workshop skill source instead; never commit these links.
/plugin-skills/

# Skill Workshop proposal generations are database-backed runtime history.
# Track applied skill source below, not staging/audit copies.
/skill-workshop/proposals/
/retired/skill-workshop-proposals/

# --- Maintained skill source ------------------------------------------
# agents/*/agent/workshop-skills/** is intentionally NOT ignored. Those
# skill files are portable source and may be reviewed and committed.
# The per-skill .archive/ folders are undo snapshots of earlier versions, not
# source: they grow with every patch, so keep them on disk and out of Git.
/agents/*/agent/workshop-skills/.archive/

# --- Generated memory state ------------------------------------------
# memory-core dreaming and promotion output is runtime state: session
# corpora, dream reports, daily notes, recall event streams and the Kalle
# agent's promoted personal memories. It is regenerated on the host and has
# no value in a public setup repository — keep it on disk, keep it out of Git.
/workspace/memory/
/workspace/DREAMS.md
/workspace-kalle-kief/memory/
/workspace-kalle-kief/DREAMS.md
/workspace-kalle-kief/MEMORY.md

# --- Secrets and key material ------------------------------------------
/config-journal-fingerprint.key
/.env
/workspace/openclaw_BAK.env
/workspace/coolify-server-access/ssh_key*

# --- Downloaded assets and local runtime state (2026-10-13) -----------
# MaxMind geolocation DB: large download, not portable source.
/geolocation/
# SQLite startup-migration run journals.
/session-sqlite-migration-runs/
# Greendex app env files carry live secrets (auth/db/oauth/SMTP).
/workspace/greendex-env-ready/
/workspace/greendex-env-backup/
# Inbound media and editor/agent skill symlink trees.
/workspace/media/
/workspace/.agents/
/workspace/.claude/
/workspace-kalle-kief/skills/
