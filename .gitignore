# Local OpenClaw setup repository: track source, not the live state directory.
# New top-level paths are private by default; add setup exceptions deliberately.
/*
!/.gitignore
!/.husky/
!/AGENTS.md
!/CONTEXT.md
!/commitlint.config.mjs
!/gateway.systemd.env
!/openclaw.json
!/openclaw.json.last-good
!/openclaw.json.pre-update
!/package.json
!/pnpm-lock.yaml
!/docs/
!/plugins/
!/scripts/
!/tests/
!/retired/
!/skills/
/retired/skill-workshop-proposals/
/skills/*/state.json

# Applied Workshop skills are setup source; other agent files are runtime.
!/agents/
/agents/*
!/agents/*/
/agents/*/*
!/agents/*/agent/
/agents/*/agent/*
!/agents/*/agent/workshop-skills/
/agents/*/agent/workshop-skills/.archive/

# Workspaces are private by default, including future agents and new projects.
# Keep agent definitions, all skill source and explicit setup/automation source.
!/workspace/
!/workspace-*/
/workspace*/*
!/workspace*/AGENTS.md
!/workspace*/IDENTITY.md
!/workspace*/SOUL.md
!/workspace*/avatars/
!/workspace*/skills/
!/workspace*/skills-lock.json
!/workspace*/.agents/
/workspace*/.agents/*
!/workspace*/.agents/skills/
!/workspace/OpenClaw-*-Setup.md
!/workspace/coolify-server-access/
/workspace/coolify-server-access/*
!/workspace/coolify-server-access/*.sh
!/workspace/lanz_cron/
/workspace/lanz_cron/*
!/workspace/lanz_cron/*.js
!/workspace/lanz_cron/package.json

# This workspace is its own repository; never stage it as an embedded gitlink.
/workspace-mail-reader/

# Generated dependencies, caches, credentials and editor state, everywhere.
node_modules/
.husky/_/
__pycache__/
*.py[cod]
*.sqlite*
*.db
*.db-*
*.bak
*.bak.*
.env
.env.*
!.env.example
!.env.sample
.vscode/
.DS_Store
*.log
